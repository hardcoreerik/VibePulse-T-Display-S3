/*
 * Kopiera till secrets.h i repytroten och fyll i. secrets.h är gitignorad —
 * känsligt stannar på den här disken.
 *
 * Notera vad som INTE finns här: inga API-tokens. VibePulse-tjänsten bor på
 * ditt eget LAN, så en stulen eller borttappad skärm läcker ditt
 * WiFi-lösenord och LAN-namnet på din Mac — båda roterar du själv, inte i
 * molnet.
 */
#ifndef TORGET_SECRETS_H
#define TORGET_SECRETS_H

/* Plattformen: WiFi (2,4 GHz — S3:an hör inget annat). */
#define TG_WIFI_SSID   ""
#define TG_WIFI_PASS   ""

/* Reservnät, t.ex. telefonens internetdelning — kortet växlar automatiskt
 * dit efter ~4 missar på hemmanätet (och tillbaka på samma vis). Tomt =
 * funktionen är av. OBS iPhone: slå på "Maximera kompatibilitet" i
 * Internetdelning, annars sänder telefonen bara 5 GHz som S3:an inte hör. */
#define TG_WIFI2_SSID  ""
#define TG_WIFI2_PASS  ""

/* VibePulse: Mac-tjänsten på LAN:et (tools/tokenserver).
 *
 * Byt DIN-MAC mot Macens Bonjour-namn — inte en IP-adress, så fungerar samma
 * firmware på både hemnät och telefon-hotspot. Namnet visas av:
 *   scutil --get LocalHostName
 *
 * URL:erna är AVSIKTLIGT aktiva här: en odefinierad URL kompilerar bort
 * hämttasken helt, och då bootar skärmen glatt och visar streck för evigt
 * utan ett enda felmeddelande. Hellre fel värdnamn (som syns i loggen) än en
 * tyst avstängd app. */
#define TK_VIBEPULSE_BASE_URL \
     "http://VIBEPULSE-HOST:8737"
#define TK_TOKENS_URL \
     TK_VIBEPULSE_BASE_URL "/api/tokens"
#define TK_AGENT_STATUS_URL \
     TK_VIBEPULSE_BASE_URL "/api/agent-status"
#define TK_MAX_TRACKER_URL \
     TK_VIBEPULSE_BASE_URL "/api/max-tracker"

/* Optional public GitHub repository module. Configure the repository on the
 * Mac service with --github-repo owner/repository (or the
 * VIBEPULSE_GITHUB_REPO environment variable), then independently choose
 * whether its full-screen Stars/Forks page and star popup are present here.
 *
 * All switches default to off so a fresh clone remains Claude/Codex-only.
 * Notifications work even when the GitHub page is disabled. Sound also
 * requires a platform backend that has passed the unit's speaker/DMA gate. */
#define TK_GITHUB_URL \
     TK_VIBEPULSE_BASE_URL "/api/github"
#define TK_GITHUB_SCREEN_ENABLED 0
#define TK_GITHUB_NOTIFICATIONS_ENABLED 0
#define TK_GITHUB_SOUND_ENABLED 0

/* Companion-appar (egna repon, byggs bara om de finns utcheckade) sätter sina
 * egna endpoints här. Exempel:
 *   #define SG_GLANCE_URL "https://exempel.se/api/glance"
 */

/* Optional local OTA maintenance token. Generate at least 32 random bytes,
 * keep it out of git, and store its counterpart outside Studio project data.
 * Without this macro the upload endpoint remains disabled. */
/* #define TG_OTA_TOKEN "replace-with-64-hex-characters" */

#endif
